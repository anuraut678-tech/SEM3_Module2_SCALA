package M2Prac_7

import breeze.linalg.{DenseVector, euclideanDistance}

object Ananya_M2Prac_7_KnnExample {
  case class DataPoint(features: DenseVector[Double], label: String)

  def main(args: Array[String]): Unit = {

    val dataset = Seq(
      DataPoint(DenseVector(3.62, 8.67, -2.81, -0.45), "1"),
      DataPoint(DenseVector(4.54, 8.00, -4.30, -1.45), "1"),
      DataPoint(DenseVector(-2.30, -0.64, 2.23, -1.24), "0"),
      DataPoint(DenseVector(-1.17, -1.43, 2.52, -0.06), "0")
    )

    println("Training data points:")
    dataset.foreach(p =>
      println(s"Features: ${p.features}, Label: ${p.label}")
    )

    val newPoint = DenseVector(3.0, 7.5, -3.0, -0.8)

    println(s"\nNew data point: $newPoint")

    var minDistance = Double.MaxValue
    var predictedLabel = ""

    for (point <- dataset) {

      val distance = euclideanDistance(newPoint, point.features)

      println(s"Distance to ${point.label}: $distance")

      if (distance < minDistance) {
        minDistance = distance
        predictedLabel = point.label
      }
    }

    println("\nClassification Result:")
    println(s"Nearest distance: $minDistance")
    println(s"Predicted label: $predictedLabel")
  }

}
